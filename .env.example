# Copier en `.env` et adapter si besoin. Le `.env` réel n'est pas versionné.

# Reproductibilité
RANDOM_SEED=42

# MLflow (étape 5+) — backend SQLite (le backend fichier ./mlruns est déprécié)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
EXPERIMENT_NAME=readmission-30d

# Sécurité API (audit : auth + rate limiting)
# API_KEY=change-me-en-prod   # si défini, /predict exige l'en-tête X-API-Key (sinon démo publique)
# RATE_LIMIT_PER_MINUTE=60    # 429 au-delà, par IP client ; 0 = désactivé
