# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets / config locale
.env

# Données (volumineuses, non versionnées) — on garde le dossier vide
data/*
!data/.gitkeep

# Modèles entraînés
models/*
!models/.gitkeep
# Le bundle final est versionné : requis par la démo Streamlit Cloud (6 Mo)
!models/model.joblib

# Rapports générés (EDA, drift, SHAP...)
reports/*
!reports/.gitkeep
!reports/*.png

# Suivi d'expériences MLflow
mlruns/

# Caches outils
.ruff_cache/
.pytest_cache/

# journal
journal/*


# MLflow (backend SQLite + artefacts)
mlflow.db
mlartifacts/
